{
  "name": "MarZ - z/OS Job Scheduler",
  "postStartCommand": "bash .devcontainer/setup-hosts.sh",
  "dockerComposeFile": "../compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installMaven": true
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "forwardPorts": [8080],
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-pull-request-github",
        "ritwickdey.liveserver",
        "ecmel.vscode-html-css",
        "vscjava.vscode-java-test",
        "ibm.zopeneditor",
        "vscjava.migrate-java-to-azure",
        "ibm.db2forzosdeveloperextension",
        "github.github-vscode-theme",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-dependency",
        "ms-python.python",
        "vscjava.vscode-maven",
        "ms-python.vscode-pylance",
        "redhat.java",
        "vscjava.vscode-java-pack",
        "zowe.vscode-extension-for-zowe",
        "batisteo.vscode-django",
        "ms-azuretools.vscode-docker",
        "xabikos.javascriptsnippets",
        "zowe.cics-extension-for-zowe",
        "dracula-theme.theme-dracula",
        "github.codespaces",
        "vscjava.vscode-gradle",
        "ckolkman.vscode-postgres",
        "ms-azuretools.vscode-containers",
        "ms-python.autopep8",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y git-lfs postgresql-client && git lfs install && npm install -g @zowe/cli"
}
